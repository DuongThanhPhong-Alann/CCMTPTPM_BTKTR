<%- include("../partials/pageStart", { title }) %>
<%- include("../partials/header") %>

<main class="container">
  <section class="slider" data-slider aria-label="Slideshow">
    <div class="slider__viewport">
      <% (slides ?? []).forEach(function (slide, i) { %>
        <img
          class="slider__img <%= i === 0 ? "is-active" : "" %>"
          src="<%= slide.src %>"
          alt="<%= slide.alt %>"
          loading="<%= i === 0 ? "eager" : "lazy" %>"
        />
      <% }) %>

      <button class="slider__btn slider__btn--prev" type="button" data-slider-prev aria-label="Previous slide">
        &#8249;
      </button>
      <button class="slider__btn slider__btn--next" type="button" data-slider-next aria-label="Next slide">
        &#8250;
      </button>

      <div class="slider__caption">
        Suspendisse quis velit at nisi ultrices tristique a eu velit.
      </div>
      <div class="slider__dots" data-slider-dots aria-hidden="true"></div>
    </div>
  </section>

  <section class="welcome">
    <h1 class="welcome__title">Welcome to Green Age</h1>

    <div class="welcome__grid">
      <article class="feature-card">
        <img class="feature-card__icon" src="/Images/icon1.png" alt="" />
        <div class="feature-card__body">
          <h2 class="feature-card__title">Download Free Templates</h2>
          <p class="feature-card__text">
            Green Age is a free <a href="#">website template</a> for everyone.
            You may edit and apply this template for any purpose.
          </p>
          <a class="feature-card__button" href="#">More</a>
        </div>
      </article>

      <article class="feature-card">
        <img class="feature-card__icon" src="/Images/icon3.png" alt="" />
        <div class="feature-card__body">
          <h2 class="feature-card__title">Online Marketing</h2>
          <p class="feature-card__text">
            Sed et eros ac mauris suscipit viverra. Sed et eros ac mauris
            suscipit viverra. Validate <a href="#">XHTML</a> and
            <a href="#">CSS</a>.
          </p>
          <a class="feature-card__button" href="#">More</a>
        </div>
      </article>
    </div>
  </section>
</main>

<script src="/js/slider.js" defer></script>
<%- include("../partials/pageEnd") %>
